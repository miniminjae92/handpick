{
  "manifest_version": 3,
  "name": "Element to Markdown",
  "version": "0.2.0",
  "description": "Select a page element and copy or save it as Markdown.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Element to Markdown",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "copy-as-markdown": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Select an element and copy it as Markdown"
    },
    "save-as-markdown": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Select an element and save it as Markdown"
    },
    "copy-as-plain-text": {
      "description": "Select an element and copy it as plain text"
    }
  }
}
